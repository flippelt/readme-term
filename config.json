{
  "window": "alex@github ~ /profile",
  "whoami": "alex",
  "boot": {
    "command": "./boot.sh",
    "ready": "welcome!",
    "steps": [
      { "key": "POST", "value": "passed" },
      { "key": "mount /dev/alex", "value": "ready" },
      { "key": "load stack: typescript rust", "value": "done" },
      { "key": "init tooling", "value": "online" }
    ]
  },
  "brew": {
    "keg_only": "human is keg-only — macOS already shipped one",
    "packages": [
      {
        "name": "rust",
        "version": "1.89.0",
        "note": "# blazingly incremental"
      },
      {
        "name": "human",
        "version": { "type": "age", "birthday": "1999-04-20" },
        "note": "# finally stable",
        "effect": "stall",
        "stall_at": 87
      },
      {
        "name": "curiosity",
        "version": "0.9.0",
        "note": "--unbounded",
        "effect": "bursts"
      },
      {
        "name": "side-quest",
        "version": "1.0.0",
        "note": "# main campaign"
      },
      {
        "name": "thinking-outside-the-box",
        "version": "0.1.0",
        "note": "# poured sideways",
        "effect": "reverse"
      }
    ]
  },
  "profile": {
    "file": "alex.ts",
    "ident": "alex",
    "type": "Dev",
    "fields": [
      { "key": "pronouns", "value": "they/them" },
      { "key": "role", "value": "developer" },
      { "key": "location", "value": "the internet" },
      { "key": "code", "value": ["TypeScript", "Rust", "Python"] },
      { "key": "focus", "value": "building things that make you grin" },
      { "key": "learning", "value": "whatever the next rabbit hole is" }
    ]
  }
}
